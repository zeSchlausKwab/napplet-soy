# Empty means no external relay connections. No public relay defaults in local mode.
VITE_NOSTR_RELAYS=
# Trusted runtime origin for canonical/OG URLs. Deploy sets this from --domain.
# Dev derives it from PORT, or SPACE_SITE_ADDRESS for dev:prod.
SPACE_SITE_ORIGIN=
# Only used with `bun run dev publicdev`. Empty uses the documented defaults.
SPACE_PUBLIC_RELAYS=
# ContextVM starter: choose relays explicitly. ws:// loopback is allowed locally.
SPACE_CVM_RELAYS=
# Persistent server key file outside source. Omit for .local/contextvm/identity.
SPACE_CVM_KEY_PATH=
# Announcements are opt-in; 0 still accepts encrypted client calls.
SPACE_CVM_ANNOUNCE=0

# Persistent names and social cache. Dev/deploy scripts set their own state path.
# For `bun run build && bun run start`, configure this explicitly.
SPACE_COMMUNITY_DIR=
