{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["bun", "vite/client"],
    "paths": {
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": [
    "apps",
    "packages",
    "scripts",
    "tests/services",
    "services/blossom",
    "services/indexer"
  ],
  "exclude": ["node_modules", "**/dist", "**/.output"]
}
